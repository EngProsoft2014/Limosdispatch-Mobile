<Project Sdk="Microsoft.NET.Sdk"><PropertyGroup>
<TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks><TargetFrameworks Condition="'$(MobileTargetFrameworks)' != ''">$(MobileTargetFrameworks)</TargetFrameworks><OutputType>Exe</OutputType><RootNamespace>LimosDispatch.Mobile</RootNamespace>
<UseMaui>true</UseMaui><SingleProject>true</SingleProject><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
<ApplicationTitle>LimosDispatch</ApplicationTitle><ApplicationId>com.limosdispatch.mobile</ApplicationId><ApplicationDisplayVersion>1.1</ApplicationDisplayVersion><ApplicationVersion>2</ApplicationVersion>
<RuntimeIdentifiers Condition="'$(Configuration)' == 'Release' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">android-arm64;android-x64</RuntimeIdentifiers>
<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26.0</SupportedOSPlatformVersion>
<MauiVersion>10.0.60</MauiVersion><AndroidPackageFormats>apk</AndroidPackageFormats><EmbedAssembliesIntoApk Condition="'$(Configuration)' == 'Release'">true</EmbedAssembliesIntoApk></PropertyGroup><ItemGroup>
<MauiIcon Include="Resources/AppIcon/appicon.svg" Color="#111D28" ForegroundFile="Resources/AppIcon/brand.png" ForegroundScale="0.9"/><MauiSplashScreen Include="Resources/Splash/brand_splash.png" Color="#111D28" BaseSize="320,120" Resize="true"/>
<MauiImage Include="Resources/Images/*"/><MauiImage Update="Resources/Images/marker_car.png" Resize="True" BaseSize="64,64"/><MauiImage Update="Resources/Images/marker_person.png" Resize="True" BaseSize="56,56"/><MauiFont Include="Resources/Fonts/*"/><MauiAsset Include="Resources/Raw/**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)"/>
<PackageReference Include="sqlite-net-base" Version="1.9.172"/><PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5"/>
<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)"/><PackageReference Include="Microsoft.Maui.Controls.Maps" Version="$(MauiVersion)"/>
<PackageReference Include="CommunityToolkit.Maui" Version="13.0.0"/>
<PackageReference Include="Plugin.Firebase.CloudMessaging" Version="4.0.1"/>
<PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.14"/><PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0"/>
</ItemGroup><ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
<GoogleServicesJson Include="Platforms/Android/google-services.json"/>
</ItemGroup><PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
<CodesignEntitlements>Platforms/iOS/Entitlements.plist</CodesignEntitlements>
<CodesignEntitlements Condition="'$(Configuration)' == 'Release'">Platforms/iOS/Entitlements.Release.plist</CodesignEntitlements>
</PropertyGroup><ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
<BundleResource Include="Platforms/iOS/GoogleService-Info.plist" LogicalName="GoogleService-Info.plist"/>
<BundleResource Include="Platforms/iOS/Resources/limosdispatch_alert.wav" LogicalName="limosdispatch_alert.wav"/>
<PackageReference Include="AdamE.Google.iOS.Maps" Version="9.2.0.8"/>
</ItemGroup><Import Project="../LimosDispatch.Core/LimosDispatch.Core.projitems" Label="Shared"/></Project>
