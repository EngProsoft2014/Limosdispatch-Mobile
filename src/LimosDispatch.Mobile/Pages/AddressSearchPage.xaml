<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:vm="clr-namespace:LimosDispatch.Mobile.ViewModels" xmlns:google="clr-namespace:LimosDispatch.Core.Services" x:Class="LimosDispatch.Mobile.Pages.AddressSearchPage" x:DataType="vm:AddressSearchViewModel" BackgroundColor="{DynamicResource Canvas}">
 <Grid RowDefinitions="Auto,*">
  <Grid BackgroundColor="{DynamicResource Navy}" Padding="20,16" ColumnDefinitions="44,*,44" ColumnSpacing="12"><Border WidthRequest="44" HeightRequest="44" Padding="10" BackgroundColor="#223442" StrokeThickness="0" StrokeShape="RoundRectangle 14"><Image Source="place_pin.png"/></Border><VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4"><Label Text="{DynamicResource Ui_PLAN_YOUR_ROUTE_f5ddcf}" TextColor="{DynamicResource Gold}" FontSize="9" CharacterSpacing="1.2"/><Label x:Name="Heading" FontSize="20" TextColor="White" FontFamily="{DynamicResource AppFontSemibold}"/></VerticalStackLayout><ImageButton Grid.Column="2" Source="close_light.png" Padding="12" WidthRequest="44" HeightRequest="44" BackgroundColor="Transparent" Clicked="OnCancel" SemanticProperties.Description="{DynamicResource Ui_Close_address_search_fd3177}"/></Grid>
  <Grid Grid.Row="1" Padding="16" RowDefinitions="Auto,Auto,*" RowSpacing="12">
   <Border Padding="4,0" HeightRequest="44" StrokeShape="RoundRectangle 14" BackgroundColor="{DynamicResource Surface}"><SearchBar x:Name="SearchInput" Text="{Binding Query}" Placeholder="{DynamicResource Ui_Street_airport_hotel_or_place_408867}"/></Border>
   <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="10"><Label Text="{Binding Status}" FontSize="12" TextColor="{DynamicResource Muted}" VerticalOptions="Center"/><Border Grid.Column="1" BackgroundColor="White" StrokeThickness="0" Padding="3" VerticalOptions="Center"><Image Source="google_attribution.png" HeightRequest="14" Aspect="AspectFit" SemanticProperties.Description="{DynamicResource Ui_Powered_by_Google_2068cc}"/></Border></Grid>
   <Grid Grid.Row="2">
    <CollectionView ItemsSource="{Binding Suggestions}" SelectionMode="None"><CollectionView.ItemTemplate><DataTemplate x:DataType="google:AddressSuggestion"><Border Margin="0,0,0,10" Padding="14" StrokeShape="RoundRectangle 16"><Border.GestureRecognizers><TapGestureRecognizer Tapped="OnResultTapped"/></Border.GestureRecognizers><Grid InputTransparent="True" ColumnDefinitions="40,*" ColumnSpacing="12"><Border WidthRequest="40" HeightRequest="40" Padding="9" BackgroundColor="{DynamicResource SoftSurface}" StrokeThickness="0" StrokeShape="RoundRectangle 12"><Image Source="place_pin.png"/></Border><VerticalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center"><Label Text="{Binding PrimaryText}" FontFamily="{DynamicResource AppFontSemibold}" FontSize="15" MaxLines="2" LineBreakMode="TailTruncation"/><Label Text="{Binding SecondaryText}" FontSize="12" TextColor="{DynamicResource Muted}" MaxLines="2" LineBreakMode="TailTruncation"/></VerticalStackLayout></Grid></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView>
    <VerticalStackLayout IsVisible="{Binding ShowIntro}" VerticalOptions="Center" Padding="32" Spacing="12" InputTransparent="True"><Border WidthRequest="72" HeightRequest="72" HorizontalOptions="Center" Padding="20" StrokeThickness="0" BackgroundColor="{DynamicResource SoftSurface}" StrokeShape="RoundRectangle 24"><Image Source="place_pin.png"/></Border><Label Text="{DynamicResource Ui_Find_the_right_place_d00bb3}" FontSize="20" FontFamily="{DynamicResource AppFontSemibold}" HorizontalTextAlignment="Center"/><Label Text="{DynamicResource Ui_Search_a_street_address_airport_or_hotel_Choose_a_Google_suggestion_fo_392b65}" TextColor="{DynamicResource Muted}" FontSize="13" HorizontalTextAlignment="Center"/></VerticalStackLayout>
    <ActivityIndicator IsVisible="{Binding IsSearching}" IsRunning="{Binding IsSearching}" Color="{DynamicResource Gold}" VerticalOptions="Start" Margin="0,20"/>
   </Grid>
  </Grid>
 </Grid>
</ContentPage>
