<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:c="clr-namespace:LimosDispatch.Mobile.Controls" xmlns:vm="clr-namespace:LimosDispatch.Mobile.ViewModels" xmlns:m="clr-namespace:LimosDispatch.Core.Models" x:Class="LimosDispatch.Mobile.Pages.DriverHistoryPage" x:DataType="vm:DriverHistoryViewModel" BackgroundColor="{DynamicResource Canvas}">
<Grid Padding="16,10" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10">
 <VerticalStackLayout Spacing="4"><Label Text="{Binding Driver.Name}" FontSize="19" FontFamily="{DynamicResource AppFontSemibold}"/><Label Text="{Binding Driver.Vehicle}" Style="{StaticResource MutedText}"/></VerticalStackLayout>
 <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="10"><VerticalStackLayout Spacing="4"><Label Text="{DynamicResource Ui_From_date_3b5d11}" Style="{StaticResource MutedText}"/><Border Style="{StaticResource Field}"><c:DateChoicePicker Date="{Binding From}" MaximumDate="{Binding Today}"/></Border></VerticalStackLayout><VerticalStackLayout Grid.Column="1" Spacing="4"><Label Text="{DynamicResource Ui_To_date_af244d}" Style="{StaticResource MutedText}"/><Border Style="{StaticResource Field}"><c:DateChoicePicker Date="{Binding To}" MaximumDate="{Binding Today}"/></Border></VerticalStackLayout></Grid>
 <VerticalStackLayout Grid.Row="2" Spacing="8"><Button Text="{DynamicResource Ui_Show_journeys_e1f741}" Command="{Binding RefreshCommand}" IsEnabled="{Binding IsBusy,Converter={StaticResource Inverse}}"/><c:ErrorBanner/><Label Text="{DynamicResource Ui_Dates_use_each_journey_s_company_timezone_b2308e}" Style="{StaticResource MutedText}"/></VerticalStackLayout>
 <CollectionView Grid.Row="3" ItemsSource="{Binding Trips}" SelectionMode="None"><CollectionView.EmptyView><Label Text="{DynamicResource Ui_No_journeys_in_this_date_range_509924}" HorizontalTextAlignment="Center" Margin="24"/></CollectionView.EmptyView><CollectionView.ItemTemplate><DataTemplate x:DataType="m:Trip"><Border Margin="0,0,0,10" Padding="14"><Border.GestureRecognizers><TapGestureRecognizer Tapped="OnTripTapped"/></Border.GestureRecognizers><VerticalStackLayout Spacing="7" InputTransparent="True"><Grid ColumnDefinitions="*,Auto"><Label Text="{Binding Schedule}" FontSize="11" Style="{StaticResource MutedText}"/><c:LocalizedStatusLabel Grid.Column="1" Status="{Binding Status}" TextColor="{DynamicResource AccentText}" FontSize="11"/></Grid><Label Text="{Binding Name}" FontFamily="{DynamicResource AppFontSemibold}"/><Label Text="{Binding From}" LineBreakMode="TailTruncation"/><Label Text="{Binding To}" Style="{StaticResource MutedText}" LineBreakMode="TailTruncation"/><Label Text="{DynamicResource Ui_View_route_and_timeline_2b5c6e}" TextColor="{DynamicResource AccentText}" FontSize="12"/></VerticalStackLayout></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView>
</Grid></ContentPage>