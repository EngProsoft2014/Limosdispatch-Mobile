<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:c="clr-namespace:LimosDispatch.Mobile.Controls" xmlns:vm="clr-namespace:LimosDispatch.Mobile.ViewModels" xmlns:m="clr-namespace:LimosDispatch.Core.Models" x:Class="LimosDispatch.Mobile.Pages.DriverHistoryPage" x:DataType="vm:DriverHistoryViewModel" BackgroundColor="{DynamicResource Canvas}">
<Grid Padding="16,10" RowDefinitions="Auto,Auto,*" RowSpacing="10">
 <VerticalStackLayout Spacing="4"><Label Text="{Binding Driver.Name}" FontSize="19" FontFamily="{DynamicResource AppFontSemibold}"/><Label Text="{Binding Driver.Vehicle}" Style="{StaticResource MutedText}"/></VerticalStackLayout>
 <VerticalStackLayout Grid.Row="1" Spacing="8"><Grid ColumnDefinitions="*,Auto"><Label Text="{Binding From, StringFormat='{0:d}'}" VerticalOptions="Center"/><ImageButton Grid.Column="1" Source="filter_menu.png" WidthRequest="44" HeightRequest="44" Padding="10" BackgroundColor="Transparent" SemanticProperties.Description="{DynamicResource Ui_Filters_96e578}" Clicked="OnFiltersClicked"/></Grid><c:ErrorBanner/><Label Text="{DynamicResource Ui_Dates_use_each_journey_s_company_timezone_b2308e}" Style="{StaticResource MutedText}"/></VerticalStackLayout>
 <CollectionView Grid.Row="2" ItemsUpdatingScrollMode="KeepScrollOffset" ItemsSource="{Binding Trips}" SelectionMode="None"><CollectionView.EmptyView><Label Text="{DynamicResource Ui_No_journeys_in_this_date_range_509924}" HorizontalTextAlignment="Center" Margin="24"/></CollectionView.EmptyView><CollectionView.ItemTemplate><DataTemplate x:DataType="m:Trip"><Border Margin="0,0,0,10" Padding="14"><Border.GestureRecognizers><TapGestureRecognizer Tapped="OnTripTapped"/></Border.GestureRecognizers><VerticalStackLayout Spacing="7" InputTransparent="True"><Grid ColumnDefinitions="*,Auto"><Label Text="{Binding Schedule}" FontSize="11" Style="{StaticResource MutedText}"/><c:LocalizedStatusLabel Grid.Column="1" Status="{Binding Status}" TextColor="{DynamicResource AccentText}" FontSize="11"/></Grid><Label Text="{Binding Name}" FontFamily="{DynamicResource AppFontSemibold}"/><Label Text="{Binding From}" LineBreakMode="TailTruncation"/><Label Text="{Binding To}" Style="{StaticResource MutedText}" LineBreakMode="TailTruncation"/><Label Text="{DynamicResource Ui_View_route_and_timeline_2b5c6e}" TextColor="{DynamicResource AccentText}" FontSize="12"/></VerticalStackLayout></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView>
</Grid></ContentPage>