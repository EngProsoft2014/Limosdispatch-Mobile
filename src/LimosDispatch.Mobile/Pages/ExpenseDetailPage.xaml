<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:vm="clr-namespace:LimosDispatch.Mobile.ViewModels" xmlns:c="clr-namespace:LimosDispatch.Mobile.Controls" x:Class="LimosDispatch.Mobile.Pages.ExpenseDetailPage" x:DataType="vm:ExpenseDetailViewModel" BackgroundColor="{DynamicResource Canvas}"><Shell.TitleView><c:CenteredBrandHeader/></Shell.TitleView><ScrollView><VerticalStackLayout Padding="16" Spacing="12"><Label Text="{Binding Expense.Name}" Style="{StaticResource Title}"/><Label Text="{Binding Expense.Amount,Converter={StaticResource Money}}" FontSize="24" FontFamily="{DynamicResource AppFontSemibold}"/><Border><VerticalStackLayout Spacing="8"><Label Text="{Binding Expense.Date}"/><Label Text="{Binding Expense.Category}"/><Label Text="{Binding Expense.Scope,Converter={StaticResource LocalizedText}}"/><Label Text="{Binding Expense.Vehicle}" IsVisible="{Binding Expense.HasVehicle}"/><Label Text="{Binding Expense.Driver}"/><Label Text="{Binding Expense.CostKind,Converter={StaticResource LocalizedText}}"/><Label Text="{Binding Expense.Notes}" IsVisible="{Binding Expense.HasNotes}"/></VerticalStackLayout></Border><Button Text="{DynamicResource Ui_View_receipt_3da41a}" Command="{Binding ReceiptCommand}" IsVisible="{Binding Expense.HasReceipt}"/><Button Text="{DynamicResource Ui_Edit_expense_5b77ee}" Command="{Binding EditCommand}" IsVisible="{Binding CanEdit}" Style="{StaticResource Secondary}"/><Button Text="{DynamicResource Ui_Delete_expense_711c08}" Command="{Binding DeleteCommand}" IsVisible="{Binding CanDelete}" Style="{StaticResource Secondary}"/><c:ErrorBanner/></VerticalStackLayout></ScrollView></ContentPage>