<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:vm="clr-namespace:LimosDispatch.Mobile.ViewModels" xmlns:m="clr-namespace:LimosDispatch.Core.Models" xmlns:controls="clr-namespace:LimosDispatch.Mobile.Controls" x:Class="LimosDispatch.Mobile.Pages.ExpensesPage" x:DataType="vm:ExpensesViewModel" Title="{DynamicResource Ui_Expenses_8d437d}" BackgroundColor="{DynamicResource Canvas}">
 <Shell.TitleView><controls:CenteredBrandHeader Title="{DynamicResource Ui_Expenses_8d437d}"/></Shell.TitleView>
 <Grid Padding="16,8,16,0" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8">
  <Border Padding="14,10" StrokeThickness="0"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><Label Text="{DynamicResource Ui_Total_expenses_67fe37}" TextColor="{DynamicResource Muted}" FontSize="12" VerticalOptions="Center"/><Label Grid.Column="1" Text="{Binding Total,Converter={StaticResource Money}}" FontSize="20" FontFamily="{DynamicResource AppFontSemibold}" VerticalOptions="Center"/></Grid></Border>
  <VerticalStackLayout Grid.Row="1" Spacing="8"><Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8"><Label Text="{Binding GeneralTotal,Converter={StaticResource Money},ConverterParameter='General: '}" FontSize="11"/><Label Grid.Column="1" Text="{Binding VehicleTotal,Converter={StaticResource Money},ConverterParameter='Vehicle: '}" FontSize="11"/><Label Grid.Column="2" Text="{Binding ReceiptCount,Converter={StaticResource LocalizedText},ConverterParameter='Receipts: {0}'}" FontSize="11"/></Grid><Grid ColumnDefinitions="*,Auto" ColumnSpacing="6"><Border Style="{StaticResource Field}"><SearchBar Text="{Binding Search}" Placeholder="{DynamicResource Ui_Search_chauffeur_or_expense_8f3ca8}"/></Border><ImageButton Grid.Column="1" Source="filter_menu.png" WidthRequest="44" HeightRequest="44" Padding="10" BackgroundColor="Transparent" SemanticProperties.Description="{DynamicResource Ui_Filters_96e578}" Clicked="OnFiltersClicked"/></Grid><Button Text="{DynamicResource Ui_Manage_categories_eceede}" Command="{Binding CategoriesCommand}" IsVisible="{Binding CanManageCategories}" Style="{StaticResource Secondary}"/></VerticalStackLayout>
  <controls:ErrorBanner Grid.Row="2"/>
  <RefreshView Grid.Row="3" Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsBusy,Mode=OneWay}">
   <CollectionView ItemsSource="{Binding Groups}" IsGrouped="True" SelectionMode="None" ItemSizingStrategy="MeasureAllItems">
    <CollectionView.EmptyView><VerticalStackLayout Padding="24" Spacing="8"><Image Source="expenses.png" WidthRequest="32" HeightRequest="32"/><Label Text="{DynamicResource Ui_No_expenses_in_this_date_range_2ea3b6}" HorizontalTextAlignment="Center"/><Label Text="{DynamicResource Ui_Change_the_dates_or_pull_down_to_refresh_c140e6}" Style="{StaticResource MutedText}" HorizontalTextAlignment="Center"/></VerticalStackLayout></CollectionView.EmptyView>
    <CollectionView.GroupHeaderTemplate><DataTemplate x:DataType="vm:ExpenseGroup"><Grid Padding="0,6,0,8" ColumnDefinitions="*,Auto" ColumnSpacing="10"><Label Text="{Binding Name}" FontSize="12" FontFamily="{DynamicResource AppFontSemibold}" MaxLines="1"/><Label Grid.Column="1" Text="{Binding Total,Converter={StaticResource Money}}" FontSize="12" FontFamily="{DynamicResource AppFontSemibold}"/></Grid></DataTemplate></CollectionView.GroupHeaderTemplate>
    <CollectionView.ItemTemplate><DataTemplate x:DataType="m:Expense"><Border Margin="0,0,0,10" Padding="14"><Border.GestureRecognizers><TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ExpensesViewModel}},Path=OpenCommand}" CommandParameter="{Binding .}"/></Border.GestureRecognizers><VerticalStackLayout Spacing="8">
     <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="5"><Label Text="{Binding Name}" FontSize="16" FontFamily="{DynamicResource AppFontSemibold}" MaxLines="1" LineBreakMode="TailTruncation"/><Label Grid.Column="1" Text="{Binding Amount,Converter={StaticResource Money}}" FontSize="18" FontFamily="{DynamicResource AppFontSemibold}" HorizontalOptions="End" HorizontalTextAlignment="End"/><Label Grid.Row="1" Text="{Binding Category}" Style="{StaticResource MutedText}" MaxLines="1" LineBreakMode="TailTruncation"/><Label Grid.Row="1" Grid.Column="1" Text="{Binding Date}" Style="{StaticResource MutedText}" HorizontalOptions="End" HorizontalTextAlignment="End"/></Grid>
     <Label Text="{Binding Scope,Converter={StaticResource LocalizedText}}" FontSize="11"/><Label Text="{Binding Vehicle}" IsVisible="{Binding HasVehicle}" FontSize="11"/><Label Text="{Binding Notes}" IsVisible="{Binding HasNotes}" FontSize="11"/><Grid ColumnDefinitions="*,Auto"><Label Text="{Binding ReceiptLabel,Converter={StaticResource LocalizedText}}" Style="{StaticResource MutedText}" VerticalOptions="Center"/><Button Grid.Column="1" Text="{DynamicResource Ui_View_receipt_3da41a}" IsVisible="{Binding HasReceipt}" Style="{StaticResource Secondary}" Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ExpensesViewModel}},Path=ReceiptCommand}" CommandParameter="{Binding .}"/></Grid>
    </VerticalStackLayout></Border></DataTemplate></CollectionView.ItemTemplate>
    <CollectionView.Footer><BoxView HeightRequest="80" Color="Transparent"/></CollectionView.Footer>
   </CollectionView>
  </RefreshView>
  <ImageButton Grid.RowSpan="5" Source="add_floating.png" Command="{Binding AddCommand}" IsVisible="{Binding CanAdd}" WidthRequest="56" HeightRequest="56" MinimumWidthRequest="56" MinimumHeightRequest="56" CornerRadius="28" Padding="16" BackgroundColor="{DynamicResource Gold}" HorizontalOptions="End" VerticalOptions="End" Margin="0,0,4,20" ZIndex="10" SemanticProperties.Description="{DynamicResource Ui_Add_an_expense_528520}"><ImageButton.Shadow><Shadow Brush="#111D28" Opacity="0.24" Radius="12" Offset="0,4"/></ImageButton.Shadow></ImageButton>
 </Grid>
</ContentPage>



