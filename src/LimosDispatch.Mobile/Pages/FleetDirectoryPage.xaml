<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:controls="clr-namespace:LimosDispatch.Mobile.Controls" x:Class="LimosDispatch.Mobile.Pages.FleetDirectoryPage" BackgroundColor="{DynamicResource Canvas}">
 <Shell.TitleView><controls:CenteredBrandHeader/></Shell.TitleView>
 <Grid Padding="16,16,16,0" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">
  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><Label x:Name="Heading" Style="{StaticResource Title}" VerticalOptions="Center"/><Button Grid.Column="1" x:Name="AddButton" Clicked="AddClicked" HeightRequest="44"/></Grid>
  <Border Grid.Row="1" BackgroundColor="{DynamicResource FieldBackground}" Stroke="{DynamicResource FieldOutline}" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="4,0"><SearchBar x:Name="Search" BackgroundColor="Transparent" HeightRequest="44" TextColor="{DynamicResource Ink}" PlaceholderColor="{DynamicResource Muted}" TextChanged="SearchChanged"/></Border>
  <ActivityIndicator Grid.Row="2" x:Name="Loading" Color="{DynamicResource Gold}" IsVisible="False"/>
  <ScrollView Grid.Row="3"><VerticalStackLayout x:Name="Rows" Spacing="8" Padding="0,0,0,16"/></ScrollView>
 </Grid>
</ContentPage>
