<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:vm="clr-namespace:LimosDispatch.Mobile.ViewModels" xmlns:m="clr-namespace:LimosDispatch.Core.Models" xmlns:c="clr-namespace:LimosDispatch.Mobile.Controls" x:Class="LimosDispatch.Mobile.Pages.PassengerSearchPage" x:DataType="vm:PassengerSearchViewModel" BackgroundColor="{DynamicResource Canvas}">
 <Grid RowDefinitions="Auto,*">
  <Grid BackgroundColor="{DynamicResource Navy}" Padding="20,16" ColumnDefinitions="*,44"><VerticalStackLayout Spacing="5"><Label Text="{DynamicResource Ui_PASSENGER_DIRECTORY_eb4bb7}" TextColor="{DynamicResource Gold}" FontSize="10" CharacterSpacing="1.1"/><Label Text="{DynamicResource Ui_Choose_your_passenger_bef2a1}" FontSize="21" FontFamily="{DynamicResource AppFontSemibold}" TextColor="White"/></VerticalStackLayout><ImageButton Grid.Column="1" Source="close_light.png" Padding="12" WidthRequest="44" HeightRequest="44" BackgroundColor="Transparent" Clicked="OnCancel" SemanticProperties.Description="{DynamicResource Ui_Close_passenger_search_152481}"/></Grid>
  <Grid Grid.Row="1" Padding="16" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12" IsEnabled="{Binding IsBusy,Converter={StaticResource Inverse}}">
   <Border Style="{StaticResource Field}" IsVisible="{Binding ShowResults}"><SearchBar Text="{Binding Query}" Placeholder="{DynamicResource Ui_Search_name_phone_or_email_face38}"/></Border>
   <VerticalStackLayout Grid.Row="1" Spacing="8"><c:ErrorBanner/><ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}" Color="{DynamicResource Gold}"/></VerticalStackLayout>
   <Grid Grid.Row="3" IsVisible="{Binding ShowResults}">
    <CollectionView ItemsSource="{Binding Results}" SelectionMode="None"><CollectionView.ItemTemplate><DataTemplate x:DataType="m:Passenger"><Border Padding="14" Margin="0,0,0,8"><Border.GestureRecognizers><TapGestureRecognizer Tapped="OnResultTapped"/></Border.GestureRecognizers><Grid InputTransparent="True" ColumnDefinitions="40,*" ColumnSpacing="12"><Border Padding="0" StrokeThickness="0" BackgroundColor="{DynamicResource SoftSurface}" WidthRequest="40" HeightRequest="40" StrokeShape="RoundRectangle 12"><Label Text="{Binding Initials}" TextColor="{DynamicResource AccentText}" FontFamily="{DynamicResource AppFontSemibold}" HorizontalOptions="Center" VerticalOptions="Center"/></Border><VerticalStackLayout Grid.Column="1" Spacing="4"><Label Text="{Binding Name}" FontFamily="{DynamicResource AppFontSemibold}" FontSize="15"/><Label Text="{Binding Contact}" TextColor="{DynamicResource Muted}" FontSize="12" LineBreakMode="TailTruncation"/></VerticalStackLayout></Grid></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView>
    <VerticalStackLayout IsVisible="{Binding NoResults}" VerticalOptions="Center" Padding="24" Spacing="10" InputTransparent="True"><Image Source="account_menu.png" WidthRequest="38" HeightRequest="38"/><Label Text="{DynamicResource Ui_No_matching_passengers_41158e}" FontSize="18" HorizontalTextAlignment="Center" FontFamily="{DynamicResource AppFontSemibold}"/><Label Text="{DynamicResource Ui_Try_another_name_or_phone_number_or_add_a_new_passenger_085bb7}" TextColor="{DynamicResource Muted}" HorizontalTextAlignment="Center"/></VerticalStackLayout>
   </Grid>
   <ScrollView Grid.Row="2" Grid.RowSpan="2" IsVisible="{Binding ShowNew}"><VerticalStackLayout Spacing="12"><Label Text="{DynamicResource Ui_New_passenger_789c53}" Style="{StaticResource Title}"/><Label Text="{DynamicResource Ui_Save_their_details_in_Customers_and_select_them_for_this_journey_012e3a}" Style="{StaticResource MutedText}"/><Border><VerticalStackLayout Spacing="10"><Label Text="{DynamicResource Ui_Full_name_eeb692}" Style="{StaticResource FieldLabel}"/><Border Style="{StaticResource Field}"><Entry Text="{Binding Name}" Placeholder="{DynamicResource Ui_Passenger_name_834778}" MaxLength="150" Unfocused="OnNameUnfocused"/></Border><c:ValidationLabel Text="{Binding NameError,Converter={StaticResource LocalizedText}}"/><Label Text="{DynamicResource Ui_Phone_77064d}" Style="{StaticResource FieldLabel}"/><Border Style="{StaticResource Field}"><Entry Text="{Binding Phone}" Placeholder="{DynamicResource Ui_Phone_number_8961d3}" Keyboard="Telephone" MaxLength="30" Unfocused="OnPhoneUnfocused" FlowDirection="LeftToRight" HorizontalTextAlignment="{DynamicResource LatinFieldTextAlignment}"/></Border><c:ValidationLabel Text="{Binding PhoneError,Converter={StaticResource LocalizedText}}"/><Label Text="{DynamicResource Ui_Email_optional_5c10b5}" Style="{StaticResource FieldLabel}"/><Border Style="{StaticResource Field}"><Entry Text="{Binding Email}" Placeholder="{DynamicResource Ui_Email_address_c94d31}" Keyboard="Email" MaxLength="254" Unfocused="OnEmailUnfocused" FlowDirection="LeftToRight" HorizontalTextAlignment="{DynamicResource LatinFieldTextAlignment}"/></Border><c:ValidationLabel Text="{Binding EmailError,Converter={StaticResource LocalizedText}}"/></VerticalStackLayout></Border><Button Text="{DynamicResource Ui_Save_select_passenger_9cf575}" Command="{Binding SaveCommand}"/><Button Text="{DynamicResource Ui_Back_to_passenger_search_9f181d}" Command="{Binding CancelNewCommand}" Style="{StaticResource Secondary}"/></VerticalStackLayout></ScrollView>
   <Border Grid.Row="2" Padding="14" IsVisible="{Binding CanShowAdd}"><Grid ColumnDefinitions="36,*" ColumnSpacing="8"><Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding NewCommand}"/></Grid.GestureRecognizers><Image Source="passenger_add.png" WidthRequest="26" HeightRequest="26" InputTransparent="True"/><VerticalStackLayout Grid.Column="1" InputTransparent="True" Spacing="3"><Label Text="{DynamicResource Ui_Add_new_passenger_8e1551}" FontFamily="{DynamicResource AppFontSemibold}" TextColor="{DynamicResource AccentText}"/><Label Text="{DynamicResource Ui_Can_t_find_them_Save_a_new_contact_cb7a0e}" FontSize="11" TextColor="{DynamicResource Muted}"/></VerticalStackLayout></Grid></Border>
  </Grid>
 </Grid>
</ContentPage>
