<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:c="clr-namespace:LimosDispatch.Mobile.Controls" xmlns:vm="clr-namespace:LimosDispatch.Mobile.ViewModels" xmlns:m="clr-namespace:LimosDispatch.Core.Models" SafeAreaEdges="Container" x:Class="LimosDispatch.Mobile.Pages.RoutePlaybackPage" x:DataType="vm:RoutePlaybackViewModel" BackgroundColor="{DynamicResource Canvas}">
<Grid RowDefinitions="*,Auto">
 <c:FleetMapView x:Name="RouteMap" IsShowingUser="False"/>
 <Border x:Name="SummaryCard" Padding="12" Margin="12" VerticalOptions="Start" StrokeThickness="0"><Grid ColumnDefinitions="*,44,44" ColumnSpacing="4"><VerticalStackLayout Spacing="3"><Label Text="{Binding Trip.Name}" FontSize="15" FontFamily="{DynamicResource AppFontSemibold}"/><Label Text="{Binding Summary}" Style="{StaticResource MutedText}" FontSize="11"/></VerticalStackLayout><ImageButton Grid.Column="1" Source="fit_route.png" WidthRequest="44" HeightRequest="44" Padding="12" Clicked="OnFit" BackgroundColor="Transparent" SemanticProperties.Description="{DynamicResource Ui_Fit_route_ccd867}"/><ImageButton Grid.Column="2" Source="expand.png" WidthRequest="44" HeightRequest="44" Padding="12" Clicked="OnFullScreen" BackgroundColor="Transparent" SemanticProperties.Description="{DynamicResource Ui_Full_screen_map_a50ec0}"/></Grid></Border>
 <HorizontalStackLayout x:Name="FullScreenActions" IsVisible="False" Grid.RowSpan="2" HorizontalOptions="End" VerticalOptions="Start" Spacing="8" Margin="12" ZIndex="10">
 <ImageButton Source="fit_route.png" BackgroundColor="{DynamicResource Surface}" CornerRadius="12" WidthRequest="44" HeightRequest="44" Padding="12" Clicked="OnFit" SemanticProperties.Description="{DynamicResource Ui_Fit_route_ccd867}"/>
 <ImageButton Source="collapse.png" BackgroundColor="{DynamicResource Surface}" CornerRadius="12" WidthRequest="44" HeightRequest="44" Padding="12" Clicked="OnFullScreen" SemanticProperties.Description="{DynamicResource Ui_Exit_full_screen_map_926d68}"/>
 </HorizontalStackLayout>
 <Border x:Name="FullScreenTransport" Grid.RowSpan="2" IsVisible="False" VerticalOptions="End" Margin="12" Padding="12,8" BackgroundColor="{DynamicResource Surface}" StrokeThickness="0" ZIndex="10"><VerticalStackLayout Spacing="2"><Grid ColumnDefinitions="*,100" ColumnSpacing="10"><VerticalStackLayout VerticalOptions="Center" Spacing="2"><Label Text="{Binding CurrentTime}" FontSize="12" FontFamily="{DynamicResource AppFontSemibold}"/><Label Text="{Binding ProgressText}" Style="{StaticResource MutedText}" FontSize="10"/></VerticalStackLayout><Button Grid.Column="1" Text="{Binding PlayText}" Clicked="OnPlay" IsEnabled="{Binding CanPlay}"/></Grid><Slider Minimum="0" Maximum="{Binding Maximum}" Value="{Binding Position,Mode=TwoWay}" DragStarted="OnScrub" MinimumTrackColor="{DynamicResource Gold}" ThumbColor="{DynamicResource Gold}" FlowDirection="LeftToRight"/></VerticalStackLayout></Border>
 <Border x:Name="PlaybackPanel" Grid.Row="1" Padding="16,12" StrokeThickness="0" BackgroundColor="{DynamicResource Surface}"><VerticalStackLayout Spacing="8">
 <c:ErrorBanner/><ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{DynamicResource Gold}"/>
 <Label Text="{DynamicResource Ui_No_recorded_locations_for_this_journey_7eb1e4}" IsVisible="{Binding HasPoints,Converter={StaticResource Inverse}}" Style="{StaticResource MutedText}"/>
 <Button Text="{DynamicResource Ui_Events_c5497b}" Clicked="OnEvents" Style="{StaticResource Secondary}" IsVisible="{Binding HasPoints,Converter={StaticResource Inverse}}"/><VerticalStackLayout Spacing="8" IsVisible="{Binding HasPoints}">
 <Grid ColumnDefinitions="*,Auto"><Label Text="{Binding CurrentTime}" FontFamily="{DynamicResource AppFontSemibold}"/><Label Grid.Column="1" Text="{Binding ProgressText}" FontSize="11" VerticalOptions="Center" Style="{StaticResource MutedText}"/></Grid>
 <Slider Minimum="0" Maximum="{Binding Maximum}" Value="{Binding Position,Mode=TwoWay}" DragStarted="OnScrub" MinimumTrackColor="{DynamicResource Gold}" ThumbColor="{DynamicResource Gold}" FlowDirection="LeftToRight"/>
 <Grid ColumnDefinitions="*,*"><Label Text="{Binding StartTime}" FontSize="10" Style="{StaticResource MutedText}"/><Label Grid.Column="1" Text="{Binding EndTime}" FontSize="10" HorizontalTextAlignment="End" Style="{StaticResource MutedText}"/></Grid>
 <Grid ColumnDefinitions="44,*,44,80" ColumnSpacing="8"><ImageButton Source="playback_start.png" Clicked="OnStart" WidthRequest="44" HeightRequest="44" Padding="12" BackgroundColor="{DynamicResource SoftSurface}" CornerRadius="12" SemanticProperties.Description="{DynamicResource Ui_Go_to_start_81469d}"/><Button Grid.Column="1" Text="{Binding PlayText}" Clicked="OnPlay" IsEnabled="{Binding CanPlay}"/><ImageButton Grid.Column="2" Source="playback_end.png" Clicked="OnEnd" WidthRequest="44" HeightRequest="44" Padding="12" CornerRadius="12" BackgroundColor="{DynamicResource SoftSurface}" SemanticProperties.Description="{DynamicResource Ui_Go_to_end_abe70f}"/><Border Grid.Column="3" Style="{StaticResource Field}"><c:ChoicePicker ItemsSource="{Binding Speeds}" SelectedItem="{Binding Speed}" Title="{DynamicResource Ui_Playback_speed_6ff42b}"/></Border></Grid>
 <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8"><Label Text="{DynamicResource Ui_Follow_vehicle_9f60f5}" VerticalOptions="Center" FontSize="12"/><Switch Grid.Column="1" IsToggled="{Binding Follow}" OnColor="{DynamicResource Gold}"/><Button Grid.Column="2" Text="{DynamicResource Ui_Events_c5497b}" Clicked="OnEvents" Style="{StaticResource Secondary}"/></Grid>
 <Label Text="{DynamicResource Ui_Recorded_GPS_only_Gaps_over_2_minutes_are_not_interpolated_255b48}" FontSize="10" Style="{StaticResource MutedText}"/>
 </VerticalStackLayout>
 <CollectionView ItemsSource="{Binding Events}" HeightRequest="118" IsVisible="{Binding ShowEvents}" SelectionMode="None"><CollectionView.ItemTemplate><DataTemplate x:DataType="vm:PlaybackEvent"><Border Padding="8" Margin="0,0,0,6"><Border.GestureRecognizers><TapGestureRecognizer Tapped="OnEvent"/></Border.GestureRecognizers><Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" InputTransparent="True"><Label Text="{Binding Time}" FontSize="11" TextColor="{DynamicResource AccentText}"/><VerticalStackLayout Grid.Column="1"><c:LocalizedStatusLabel Status="{Binding Title}" FontSize="12"/><Label Text="{Binding Detail}" Style="{StaticResource MutedText}" FontSize="10"/></VerticalStackLayout></Grid></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView>
 </VerticalStackLayout></Border>
</Grid></ContentPage>