<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:vm="clr-namespace:LimosDispatch.Mobile.ViewModels" xmlns:c="clr-namespace:LimosDispatch.Mobile.Controls" x:Class="LimosDispatch.Mobile.Pages.SynchronizationPage" x:DataType="vm:SynchronizationViewModel" BackgroundColor="{DynamicResource Canvas}">
 <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="16,12" RowSpacing="12">
  <Border Padding="16"><VerticalStackLayout Spacing="6"><Label x:Name="HeadingLabel" FontSize="18" FontFamily="{DynamicResource AppFontSemibold}"/><Label Text="{Binding Summary}" FontFamily="{DynamicResource AppFontSemibold}" FontSize="16"/><Label x:Name="DescriptionLabel" Style="{StaticResource MutedText}" FontSize="12"/></VerticalStackLayout></Border>
  <Button Grid.Row="1" x:Name="SyncNowButton" Command="{Binding SynchronizeCommand}" HeightRequest="44"/>
  <CollectionView Grid.Row="2" ItemsSource="{Binding Rows}" SelectionMode="None"><CollectionView.EmptyView><Label x:Name="EmptyLabel" Margin="12,32" HorizontalTextAlignment="Center" Style="{StaticResource MutedText}"/></CollectionView.EmptyView><CollectionView.ItemTemplate><DataTemplate x:DataType="vm:SynchronizationRow"><Border Padding="16" Margin="0,0,0,10"><VerticalStackLayout Spacing="7"><Label Text="{Binding Title}" FontFamily="{DynamicResource AppFontSemibold}" FontSize="15"/><Label Text="{Binding Status}" TextColor="{DynamicResource AccentText}" FontSize="13"/><Label Text="{Binding Counts}" Style="{StaticResource MutedText}" FontSize="12"/><Label Text="{Binding EndedAt}" Style="{StaticResource MutedText}" FontSize="11"/><Label Text="{Binding Reason}" IsVisible="{Binding HasReason}" FontSize="12"/></VerticalStackLayout></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView>
  <VerticalStackLayout Grid.Row="3"><c:ErrorBanner/><ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{DynamicResource Gold}"/></VerticalStackLayout>
 </Grid>
</ContentPage>
