<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:maps="http://schemas.microsoft.com/dotnet/2021/maui/maps" xmlns:vm="clr-namespace:LimosDispatch.Mobile.ViewModels" xmlns:m="clr-namespace:LimosDispatch.Core.Models" xmlns:c="clr-namespace:LimosDispatch.Mobile.Controls" x:Class="LimosDispatch.Mobile.Pages.TrackingPage" x:DataType="vm:TrackingViewModel" Title="{DynamicResource Ui_Tracking_e81a15}" BackgroundColor="{DynamicResource Canvas}">
 <Grid RowDefinitions="Auto,*">
 <Border x:Name="TrackingTabs" Margin="16,8,16,4" Padding="3" StrokeThickness="0" BackgroundColor="{DynamicResource Surface}"><Grid ColumnDefinitions="*,*" ColumnSpacing="4"><Button x:Name="LiveTab" Text="{DynamicResource Ui_Live_65c821}" Clicked="OnLiveTab"/><Button x:Name="HistoryTab" Grid.Column="1" Text="{DynamicResource Ui_History_90ccd6}" Style="{StaticResource Secondary}" Clicked="OnHistoryTab"/></Grid></Border>
 <Grid x:Name="LivePanel" Grid.Row="1" RowDefinitions="Auto,*">
  <VerticalStackLayout Padding="16,10" Spacing="8" IsVisible="{Binding ShowHeader}">
   <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><VerticalStackLayout Spacing="4"><Label Text="{DynamicResource Ui_Live_tracking_17d2f3}" Style="{StaticResource Title}"/><Label Text="{Binding Updated}" Style="{StaticResource MutedText}"/><Label Text="{Binding UpdateMode}" FontSize="10" Style="{StaticResource MutedText}"/></VerticalStackLayout>
    <Border Grid.Column="1" Padding="3" BackgroundColor="{DynamicResource Surface}" StrokeThickness="0" StrokeShape="RoundRectangle 14"><HorizontalStackLayout Spacing="4">
     <ImageButton Source="view_list.png" WidthRequest="44" HeightRequest="44" Padding="10" BackgroundColor="Transparent" CornerRadius="10" Clicked="OnListClicked" SemanticProperties.Description="{DynamicResource Ui_List_a1fffa}"><ImageButton.Triggers><DataTrigger TargetType="ImageButton" Binding="{Binding ListMode}" Value="True"><Setter Property="BackgroundColor" Value="{DynamicResource SoftSurface}"/></DataTrigger></ImageButton.Triggers></ImageButton>
     <ImageButton Source="view_map.png" WidthRequest="44" HeightRequest="44" Padding="10" BackgroundColor="Transparent" CornerRadius="10" Clicked="OnMapClicked" SemanticProperties.Description="{DynamicResource Ui_Map_ab478f}"><ImageButton.Triggers><DataTrigger TargetType="ImageButton" Binding="{Binding MapMode}" Value="True"><Setter Property="BackgroundColor" Value="{DynamicResource SoftSurface}"/></DataTrigger></ImageButton.Triggers></ImageButton>
    </HorizontalStackLayout></Border>
   </Grid><c:ErrorBanner/>
  </VerticalStackLayout>
  <RefreshView Grid.Row="1" Margin="16,0" IsVisible="{Binding ListMode}" Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsBusy,Mode=OneWay}">
   <CollectionView ItemsSource="{Binding Drivers}" SelectionMode="None" ItemSizingStrategy="MeasureAllItems">
    <CollectionView.EmptyView><VerticalStackLayout Padding="28" Spacing="12"><Image Source="tracking.png" WidthRequest="36" HeightRequest="36"/><Label Text="{DynamicResource Ui_No_active_chauffeurs_4cacb6}" FontSize="18" HorizontalTextAlignment="Center"/><Label Text="{DynamicResource Ui_Drivers_sharing_their_location_during_a_ride_will_appear_here_4d93d7}" Style="{StaticResource MutedText}" HorizontalTextAlignment="Center"/></VerticalStackLayout></CollectionView.EmptyView>
    <CollectionView.ItemTemplate><DataTemplate x:DataType="m:TrackedDriver"><Border Margin="0,0,0,10"><Border.GestureRecognizers><TapGestureRecognizer Tapped="OnDriverTapped"/></Border.GestureRecognizers><Grid InputTransparent="True" ColumnDefinitions="34,*,Auto" ColumnSpacing="10"><Image Source="more.png" WidthRequest="24" HeightRequest="24"/><VerticalStackLayout Grid.Column="1" Spacing="4"><Label Text="{Binding DisplayName}" FontFamily="{DynamicResource AppFontSemibold}"/><Label Text="{Binding Freshness,Converter={StaticResource LocalizedText}}" Style="{StaticResource MutedText}"/></VerticalStackLayout><Image Grid.Column="2" Source="view_map.png" WidthRequest="22" HeightRequest="22"/></Grid></Border></DataTemplate></CollectionView.ItemTemplate>
   </CollectionView>
  </RefreshView>
  <Grid Grid.Row="1" IsVisible="{Binding MapMode}">
   <c:FleetMapView x:Name="FleetMap" IsShowingUser="False" MapType="Street"/>
   <ImageButton x:Name="ExpandButton" Source="expand.png" WidthRequest="44" HeightRequest="44" Padding="10" BackgroundColor="{DynamicResource Surface}" CornerRadius="12" Margin="12" HorizontalOptions="End" VerticalOptions="Start" Clicked="OnExpandClicked" SemanticProperties.Description="{DynamicResource Ui_Full_screen_map_a50ec0}"/>
  </Grid>
 </Grid>
<Grid x:Name="HistoryPanel" Grid.Row="1" IsVisible="False" RowDefinitions="Auto,Auto,*" Padding="16,8" RowSpacing="10" x:DataType="vm:TrackingHistoryViewModel">
 <VerticalStackLayout Spacing="4"><Label Text="{DynamicResource Ui_History_90ccd6}" Style="{StaticResource Title}"/><Label Text="{DynamicResource Ui_Choose_a_chauffeur_to_review_recorded_journeys_e0ab62}" Style="{StaticResource MutedText}"/></VerticalStackLayout>
 <Border Grid.Row="1" Style="{StaticResource Field}"><SearchBar Text="{Binding Query}" Placeholder="{DynamicResource Ui_Search_chauffeurs_or_vehicles_77f9d4}"/></Border>
 <Grid Grid.Row="2"><CollectionView ItemsSource="{Binding Drivers}" SelectionMode="None"><CollectionView.EmptyView><Label Text="{DynamicResource Ui_No_chauffeurs_found_27664a}" HorizontalTextAlignment="Center" Margin="24"/></CollectionView.EmptyView><CollectionView.ItemTemplate><DataTemplate x:DataType="m:Driver"><Border Margin="0,0,0,10"><Border.GestureRecognizers><TapGestureRecognizer Tapped="OnHistoryDriverTapped"/></Border.GestureRecognizers><Grid ColumnDefinitions="44,*" ColumnSpacing="12" InputTransparent="True"><Image Source="marker_car.png" WidthRequest="40" HeightRequest="40"/><VerticalStackLayout Grid.Column="1" Spacing="4"><Label Text="{Binding Name}" FontFamily="{DynamicResource AppFontSemibold}"/><Label Text="{Binding Vehicle}" Style="{StaticResource MutedText}"/></VerticalStackLayout></Grid></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView><ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{DynamicResource Gold}" VerticalOptions="Start"/><c:ErrorBanner VerticalOptions="End"/></Grid>
 </Grid>
 </Grid></ContentPage>

